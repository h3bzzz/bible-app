{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bible",
  "version": "0.1.0",
  "identifier": "org.bibleapp.reader",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Bible",
        "width": 820,
        "height": 900,
        "minWidth": 320,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../../build/corpus.db"]
  }
}
