# ==============================================================================
# Bible App — .gitignore
# Tauri 2 (Rust workspace) + Svelte/Vite frontend, targeting desktop today and
# iOS / Android (App Store & Google Play) later.
#
# Principle: commit SOURCE only. Anything generated, cached, machine-specific,
# oversized, or secret is excluded. A fresh clone + `data/vendor/` + the build
# tools is enough for anyone to build and run the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# Rust / Cargo
# ------------------------------------------------------------------------------
# Build cache (currently ~6 GB). Applies to the workspace root and any nested
# crate that ends up with its own target dir.
/target/
**/target/

# Backtrace / crash dumps
*.rs.bk

# MSVC Windows debug info
*.pdb

# cargo-mutants output
**/mutants.out*/

# NOTE: Cargo.lock IS committed. This repo produces applications (not a library),
# so the exact dependency graph must be reproducible.

# ------------------------------------------------------------------------------
# Node / npm (apps/ui — Svelte + Vite frontend)
# ------------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / Svelte build output & caches (regenerated by `npm run build`)
apps/ui/dist/
**/.vite/
**/.svelte-kit/
.eslintcache

# ------------------------------------------------------------------------------
# Tauri
# ------------------------------------------------------------------------------
# Generated ACL / permission schemas (Tauri regenerates these on build)
apps/desktop/gen/schemas/

# Tauri build cache
**/.tauri/

# ------------------------------------------------------------------------------
# Generated data / build artifacts
# ------------------------------------------------------------------------------
# The compiled corpus database (~166 MB, exceeds GitHub's 100 MB file cap).
# Rebuild locally with the build-corpus tool from data/vendor/ sources.
build/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Keep data/vendor source bibles (USFM zips + checksums) — they are inputs, not
# outputs — but drop anything unpacked/generated there.
data/vendor/**/extracted/
data/**/*.tmp

# ------------------------------------------------------------------------------
# Secrets & signing material  (CRITICAL — never publish these)
# ------------------------------------------------------------------------------
# Environment / config secrets
.env
.env.*
!.env.example
*.local

# Generic keys & certificates
*.pem
*.key
*.p12
*.pfx

# --- Android signing (Google Play) ---
*.keystore
*.jks
keystore.properties
key.properties
# Firebase / Play config that may carry keys
google-services.json

# --- Apple signing / provisioning (App Store) ---
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
# Fastlane / match & CI signing artifacts
apps/**/fastlane/report.xml
apps/**/fastlane/Preview.html
apps/**/fastlane/screenshots/**/*.png
apps/**/fastlane/test_output/
GoogleService-Info.plist

# ------------------------------------------------------------------------------
# Future mobile: Tauri iOS (gen/apple) — commit the project, ignore build output
# ------------------------------------------------------------------------------
apps/desktop/gen/apple/.tauri/
apps/desktop/gen/apple/build/
apps/desktop/gen/apple/DerivedData/
apps/desktop/gen/apple/Externals/
apps/desktop/gen/apple/Pods/
apps/desktop/gen/apple/*.xcodeproj/project.xcworkspace/xcuserdata/
apps/desktop/gen/apple/*.xcodeproj/xcuserdata/
apps/desktop/gen/apple/*.xcworkspace/xcuserdata/

# ------------------------------------------------------------------------------
# Future mobile: Tauri Android (gen/android) — commit the project, ignore builds
# ------------------------------------------------------------------------------
apps/desktop/gen/android/.tauri/
apps/desktop/gen/android/.gradle/
apps/desktop/gen/android/.idea/
apps/desktop/gen/android/build/
apps/desktop/gen/android/app/build/
apps/desktop/gen/android/local.properties
apps/desktop/gen/android/app/src/main/jniLibs/
apps/desktop/gen/android/app/src/main/assets/
apps/desktop/gen/android/captures/

# ------------------------------------------------------------------------------
# Operating system cruft
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
*.sublime-workspace

# ------------------------------------------------------------------------------
# Claude Code (dev tooling — user/machine specific)
# ------------------------------------------------------------------------------
.claude/settings.local.json

# ------------------------------------------------------------------------------
# Logs & misc temp
# ------------------------------------------------------------------------------
*.log
*.tmp
tmp/
.cache/
